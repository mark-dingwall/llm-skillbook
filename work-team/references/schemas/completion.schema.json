{
  "type": "object",
  "required": ["missing_residual"],
  "properties": {
    "missing_residual": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "detail", "source"],
        "allOf": [
          {
            "if": {"properties": {"kind": {"enum": ["finding", "loop_cap"]}}},
            "then": {"required": ["severity", "scope"]}
          }
        ],
        "properties": {
          "kind": {"type": "string", "enum": ["finding", "gap", "worker_failed", "loop_cap", "invalid_return", "skipped"]},
          "detail": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "severity": {"type": "string", "enum": ["blocker", "important", "minor"]},
          "scope": {"type": "string", "enum": ["spec", "adjacent"]},
          "source": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    }
  }
}
