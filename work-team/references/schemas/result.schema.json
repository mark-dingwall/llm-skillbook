{
  "type": "object",
  "required": ["run", "outcome", "verification", "residual", "workers", "plan", "log"],
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "complete"}}},
      "then": {
        "properties": {
          "verification": {
            "minItems": 1,
            "items": {"properties": {"passed": {"const": true}}}
          },
          "residual": {
            "items": {
              "allOf": [
                {
                  "if": {"properties": {"kind": {"const": "finding"}}},
                  "then": {"properties": {"severity": {"enum": ["minor"]}}}
                }
              ]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "run": {"type": "string"},
    "outcome": {"type": "string", "enum": ["complete", "partial", "stopped"]},
    "verification": {
      "type": "array",
      "items": {
        "type": "object", "required": ["command", "passed"],
        "properties": {"command": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}, "summary": {"type": "string"}}
      }
    },
    "residual": {
      "type": "array",
      "items": {
        "type": "object", "required": ["kind", "detail"],
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "finding"}}},
            "then": {"required": ["severity", "scope"]}
          }
        ],
        "properties": {
          "kind": {"type": "string", "enum": ["finding", "gap", "worker_failed", "loop_cap", "invalid_return", "skipped"]},
          "detail": {"type": "string"},
          "severity": {"type": "string", "enum": ["blocker", "important", "minor"]},
          "scope": {"type": "string", "enum": ["spec", "adjacent"]},
          "source": {"type": "string"}
        }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "role", "status"],
        "properties": {
          "id": {"type": "string"}, "role": {"type": "string"},
          "status": {"type": "string", "enum": ["ok", "failed", "retried", "invalid"]},
          "summary": {"type": "string"}
        }
      }
    },
    "plan": {"type": "string"},
    "log": {"type": "string"}
  }
}
