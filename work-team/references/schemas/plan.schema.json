{
  "type": "object",
  "required": ["run", "task", "phases"],
  "properties": {
    "run": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "task": {"type": "string"},
    "phases": {
      "type": "array", "minItems": 1, "uniqueBy": "id",
      "items": {
        "type": "object",
        "required": ["id", "workers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "barrier": {"type": "boolean"},
          "loop": {
            "type": "object", "required": ["review", "fix", "max_rounds"],
            "properties": {
              "review": {"type": "string", "enum": ["reviewer", "judge"]},
              "fix": {"type": "string", "const": "fixer"},
              "max_rounds": {"type": "integer", "minimum": 1}
            }
          },
          "workers": {
            "type": "array", "minItems": 1, "uniqueBy": "id",
            "disjointNormalizedPathsBy": "owns",
            "noConcurrentInputDependencies": true,
            "items": {
              "type": "object",
              "required": ["id", "role", "goal", "inputs", "owns", "verify"],
              "allOf": [
                {
                  "if": {"properties": {"role": {"enum": ["reviewer", "verifier", "judge"]}}},
                  "then": {"properties": {"owns": {"const": []}}}
                }
              ],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
                "role": {
                  "type": "string",
                  "enum": ["writer", "implementer", "reviewer", "verifier", "fixer", "judge"]
                },
                "goal": {"type": "string", "pattern": "\\S"},
                "inputs": {"type": "array", "items": {"type": "string"}},
                "owns": {"type": "array", "items": {"type": "string", "repoRelativePath": true}},
                "verify": {"type": "string", "pattern": "\\S"},
                "group": {"type": "string"},
                "model": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
