{
  "type": "object",
  "required": ["run", "task", "phases"],
  "properties": {
    "run": {"type": "string"},
    "task": {"type": "string"},
    "phases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "workers"],
        "properties": {
          "id": {"type": "string"},
          "barrier": {"type": "boolean"},
          "loop": {
            "type": "object", "required": ["review", "fix", "max_rounds"],
            "properties": {
              "review": {"type": "string"}, "fix": {"type": "string"},
              "max_rounds": {"type": "integer", "minimum": 1}
            }
          },
          "workers": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "role", "goal", "inputs", "owns", "verify"],
              "properties": {
                "id": {"type": "string"},
                "role": {
                  "type": "string",
                  "enum": ["writer", "implementer", "reviewer", "verifier", "fixer", "judge"]
                },
                "goal": {"type": "string"},
                "inputs": {"type": "array", "items": {"type": "string"}},
                "owns": {"type": "array", "items": {"type": "string"}},
                "verify": {"type": "string"},
                "group": {"type": "string"},
                "model": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
