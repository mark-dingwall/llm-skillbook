{
  "type": "object",
  "candidateOwnedPaths": true,
  "required": ["run", "task", "phases"],
  "properties": {
    "run": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\Z"},
    "task": {"type": "string"},
    "phases": {
      "type": "array", "minItems": 1, "uniqueBy": "id",
      "items": {
        "type": "object",
        "required": ["id", "workers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\Z"},
          "barrier": {"type": "boolean"},
          "loop": {
            "type": "object", "required": ["review", "fix", "max_rounds"],
            "properties": {
              "review": {"type": "string", "const": "reviewer"},
              "fix": {"type": "string", "const": "fixer"},
              "max_rounds": {"type": "integer", "minimum": 1}
            }
          },
          "workers": {
            "type": "array", "minItems": 1, "uniqueBy": "id",
            "disjointNormalizedPathsBy": "owns",
            "noConcurrentInputDependencies": true,
            "items": {
              "type": "object",
              "required": ["id", "role", "goal", "inputs", "owns"],
              "allOf": [
                {
                  "if": {"properties": {"role": {"enum": ["reviewer", "verifier", "judge"]}}},
                  "then": {"forbiddenProperties": ["verify"], "properties": {"owns": {"const": []}}}
                },
                {
                  "if": {"properties": {"role": {"enum": ["writer", "implementer", "fixer"]}}},
                  "then": {"required": ["verify"]}
                },
                {
                  "if": {"properties": {"role": {"const": "verifier"}}},
                  "then": {"required": ["candidates"]}
                }
              ],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\Z"},
                "role": {
                  "type": "string",
                  "enum": ["writer", "implementer", "reviewer", "verifier", "fixer", "judge"]
                },
                "goal": {"type": "string", "pattern": "\\S"},
                "inputs": {"type": "array", "items": {"type": "string"}},
                "owns": {"type": "array", "items": {"type": "string", "repoRelativePath": true, "notRepoPathPrefix": ".work-team"}},
                "verify": {"type": "string", "pattern": "\\S"},
                "candidates": {
                  "type": "array", "minItems": 1, "uniqueBy": "id",
                  "items": {
                    "type": "object", "required": ["id", "owner", "path", "issue"],
                    "properties": {
                      "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*\\Z"},
                      "owner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\Z"},
                      "path": {"type": "string", "repoRelativePath": true, "notRepoPathPrefix": ".work-team"},
                      "issue": {"type": "string", "pattern": "\\S"}
                    }
                  }
                },
                "group": {"type": "string"},
                "model": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
