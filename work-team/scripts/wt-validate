#!/usr/bin/env python3
"""Validate a worker result against a JSON schema subset.
usage: wt-validate <schema.json> [result.json]   (reads stdin if omitted)

Supports: type, required, properties, items, enum, const, minimum, minItems,
allOf, and if/then. Exit 0 = valid (exit 1 = invalid; exit 2 = not JSON).
A worker's final message may wrap JSON in ```json fences; they are stripped.
"""
import json
import re
import sys

TYPES = {"object": dict, "array": list, "string": str, "integer": int,
         "number": (int, float), "boolean": bool, "null": type(None)}


def check(v, s, path="$"):
    errs = []
    t = s.get("type")
    if t:
        ok = isinstance(v, TYPES[t]) and not (t in ("integer", "number") and isinstance(v, bool))
        if not ok:
            return [f"{path}: expected {t}, got {type(v).__name__}"]
    if "enum" in s and v not in s["enum"]:
        errs.append(f"{path}: {v!r} not in {s['enum']}")
    if "const" in s and v != s["const"]:
        errs.append(f"{path}: expected constant {s['const']!r}, got {v!r}")
    if "minimum" in s and isinstance(v, (int, float)) and v < s["minimum"]:
        errs.append(f"{path}: {v!r} is less than minimum {s['minimum']!r}")
    for sub in s.get("allOf", []):
        errs += check(v, sub, path)
    if "if" in s and "then" in s and not check(v, s["if"], path):
        errs += check(v, s["then"], path)
    if isinstance(v, dict):
        for k in s.get("required", []):
            if k not in v:
                errs.append(f"{path}.{k}: required")
        for k, sub in s.get("properties", {}).items():
            if k in v:
                errs += check(v[k], sub, f"{path}.{k}")
    if isinstance(v, list):
        if len(v) < s.get("minItems", 0):
            errs.append(f"{path}: fewer than {s['minItems']} items")
        if "items" in s:
            for i, x in enumerate(v):
                errs += check(x, s["items"], f"{path}[{i}]")
    return errs


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    schema = json.load(open(sys.argv[1]))
    raw = open(sys.argv[2]).read() if len(sys.argv) > 2 else sys.stdin.read()
    m = re.search(r"```(?:json)?\s*(.*?)```", raw, re.S)
    raw = m.group(1) if m else raw
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"not JSON: {e}", file=sys.stderr)
        sys.exit(2)
    errs = check(data, schema)
    if errs:
        print("\n".join(errs), file=sys.stderr)
        sys.exit(1)
    json.dump(data, sys.stdout)


main()
