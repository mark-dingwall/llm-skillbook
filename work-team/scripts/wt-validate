#!/usr/bin/env python3
"""Validate a worker result against a JSON schema subset.
usage: wt-validate <schema.json> [result.json]   (reads stdin if omitted)

Supports: type, required, properties, items, enum, const, minimum, minLength,
pattern, minItems, contains, uniqueBy, repoRelativePath,
disjointNormalizedPathsBy, allOf, and if/then.
Exit 0 = valid; exit 1 = invalid.
A worker's final message may wrap JSON in ```json fences; they are stripped.
"""
import json
import posixpath
import re
import sys

TYPES = {"object": dict, "array": list, "string": str, "integer": int,
         "number": (int, float), "boolean": bool, "null": type(None)}


def check(v, s, path="$"):
    errs = []
    t = s.get("type")
    if t:
        ok = isinstance(v, TYPES[t]) and not (t in ("integer", "number") and isinstance(v, bool))
        if not ok:
            return [f"{path}: expected {t}, got {type(v).__name__}"]
    if "enum" in s and v not in s["enum"]:
        errs.append(f"{path}: {v!r} not in {s['enum']}")
    if "const" in s and v != s["const"]:
        errs.append(f"{path}: expected constant {s['const']!r}, got {v!r}")
    if "minimum" in s and isinstance(v, (int, float)) and v < s["minimum"]:
        errs.append(f"{path}: {v!r} is less than minimum {s['minimum']!r}")
    if isinstance(v, str) and len(v) < s.get("minLength", 0):
        errs.append(f"{path}: shorter than {s['minLength']} characters")
    if isinstance(v, str) and "pattern" in s and not re.search(s["pattern"], v):
        errs.append(f"{path}: does not match pattern {s['pattern']!r}")
    if isinstance(v, str) and s.get("repoRelativePath"):
        normalized = posixpath.normpath(v)
        if (
            not v
            or posixpath.isabs(v)
            or normalized in (".", "..")
            or normalized.startswith("../")
        ):
            errs.append(f"{path}: expected a path within the repository")
    for sub in s.get("allOf", []):
        errs += check(v, sub, path)
    if "if" in s and "then" in s and not check(v, s["if"], path):
        errs += check(v, s["then"], path)
    if isinstance(v, dict):
        for k in s.get("required", []):
            if k not in v:
                errs.append(f"{path}.{k}: required")
        for k, sub in s.get("properties", {}).items():
            if k in v:
                errs += check(v[k], sub, f"{path}.{k}")
    if isinstance(v, list):
        if len(v) < s.get("minItems", 0):
            errs.append(f"{path}: fewer than {s['minItems']} items")
        if "uniqueBy" in s:
            key = s["uniqueBy"]
            values = [
                json.dumps(x[key], sort_keys=True, separators=(",", ":"))
                for x in v if isinstance(x, dict) and key in x
            ]
            if len(values) != len(set(values)):
                errs.append(f"{path}: duplicate {key!r} values")
        if "contains" in s and not any(not check(x, s["contains"]) for x in v):
            errs.append(f"{path}: no item matches the required schema")
        if "disjointNormalizedPathsBy" in s:
            key = s["disjointNormalizedPathsBy"]
            owners = {}
            for i, item in enumerate(v):
                if not isinstance(item, dict) or not isinstance(item.get(key), list):
                    continue
                for raw in item[key]:
                    if not isinstance(raw, str):
                        continue
                    normalized = posixpath.normpath(raw)
                    if normalized in owners and owners[normalized] != i:
                        errs.append(
                            f"{path}: normalized path {normalized!r} is owned by "
                            f"workers at indexes {owners[normalized]} and {i}"
                        )
                    else:
                        owners[normalized] = i
        if "items" in s:
            for i, x in enumerate(v):
                errs += check(x, s["items"], f"{path}[{i}]")
    return errs


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    schema = json.load(open(sys.argv[1]))
    raw = open(sys.argv[2]).read() if len(sys.argv) > 2 else sys.stdin.read()
    m = re.search(r"```(?:json)?\s*(.*?)```", raw, re.S)
    raw = m.group(1) if m else raw
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"not JSON: {e}", file=sys.stderr)
        sys.exit(2)
    errs = check(data, schema)
    if errs:
        print("\n".join(errs), file=sys.stderr)
        sys.exit(1)
    json.dump(data, sys.stdout)


main()
